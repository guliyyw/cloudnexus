# CloudNexus 环境变量模板
# 复制为 .env 并根据需要修改

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_USER=cloudnexus
DB_PASSWORD=cloudnexus
DB_NAME=cloudnexus

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cloudnexus

# JWT
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh

# 服务端口
USER_FILE_SVC_PORT=8081
IM_SVC_PORT=8082
DOCKER_SVC_PORT=8083
