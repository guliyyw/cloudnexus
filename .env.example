# CloudNexus 环境变量模板
# 复制为 .env 并根据需要修改
# ⚠️ 警告：生产环境必须使用强密码，且不能保留默认值

# ============================================
# 数据库配置（必填）
# ============================================
# PostgreSQL 密码 - 必须修改，不能使用默认值
POSTGRES_PASSWORD=<CHANGE-ME-STRONG-PASSWORD>

# Redis 密码 - 必须修改，不能使用默认值
REDIS_PASSWORD=<CHANGE-ME-STRONG-PASSWORD>

# MinIO 管理员凭证 - 必须修改，不能使用默认值
MINIO_ROOT_USER=<CHANGE-ME-ACCESS-KEY>
MINIO_ROOT_PASSWORD=<CHANGE-ME-STRONG-PASSWORD>

# ============================================
# 默认管理员配置（必填）
# ============================================
# 默认管理员密码 - 必须修改，不能使用默认值
DEFAULT_ADMIN_PASSWORD=<CHANGE-ME-STRONG-PASSWORD>

# ============================================
# AI 推理服务配置（必填）
# ============================================
# AI 推理服务认证 Token - 必须修改，不能使用默认值
AI_INFERENCE_TOKEN=<CHANGE-ME-STRONG-TOKEN>

# ============================================
# 数据库连接配置（开发环境默认即可）
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=cloudnexus
DB_NAME=cloudnexus

# Redis 连接配置（开发环境默认即可）
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO 连接配置（开发环境默认即可）
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=cloudnexus

# ============================================
# JWT 密钥配置（生产环境必须修改）
# ============================================
JWT_ACCESS_SECRET=<CHANGE-ME-JWT-ACCESS-SECRET-MIN-32-CHARS>
JWT_REFRESH_SECRET=<CHANGE-ME-JWT-REFRESH-SECRET-MIN-32-CHARS>

# ============================================
# 服务端口配置（可选）
# ============================================
USER_FILE_SVC_PORT=8081
IM_SVC_PORT=8082
DOCKER_SVC_PORT=8083
CAMERA_SVC_PORT=8085
COLLAB_SVC_PORT=8086

# ============================================
# 可选配置
# ============================================
# 默认管理员用户名和邮箱（可选）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@cloudnexus.local

# 服务版本（可选）
SERVICE_VERSION=latest
